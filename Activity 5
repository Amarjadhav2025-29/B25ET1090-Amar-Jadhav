#include <iostream>
using namespace std;

int sum(int arr[], int n)
{
    int total = 0;

    for (int i = 0; i < n; i++)
    {
        total = total + arr[i];
    }

    return total;
}

float sum(float arr[], int n)
{
    float total = 0;

    for (int i = 0; i < n; i++)
    {
        total = total + arr[i];
    }

    return total;
}

int main()
{
    int intArray[] = {10, 20, 30, 40, 50};
    float floatArray[] = {1.5, 2.5, 3.5, 4.5, 5.5};

    int n1 = 5;
    int n2 = 5;

    cout << "Sum of integer array = "
         << sum(intArray, n1) << endl;

    cout << "Sum of floating-point array = "
         << sum(floatArray, n2) << endl;

    return 0;
}
