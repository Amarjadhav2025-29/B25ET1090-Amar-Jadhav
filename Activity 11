#include <iostream>          // Header file for input and output
#include <string>            // Header file for string data type
using namespace std;         // Use standard namespace

// Function template to find maximum value
template <class T>
T maximumValue(T a, T b)
{
    return (a > b) ? a : b;     // Return the greater value
}

// Class template to store and display a value
template <class T>
class Box
{
    T value;                    // Variable to store value

public:
    Box(T v)                    // Parameterized constructor
    {
        value = v;              // Initialize value
    }

    void display()              // Function to display value
    {
        cout << "Box value = " << value << endl;
    }
};

int main()
{
    // Function template with integer values
    cout << "Maximum integer = "
         << maximumValue(10, 25) << endl;

    // Function template with double values
    cout << "Maximum double = "
         << maximumValue(3.5, 5.5) << endl;

    // Class template with integer type
    Box<int> b1(100);
    b1.display();

    // Class template with string type
    Box<string> b2("C++ Templates");
    b2.display();

    return 0;                // End program
}
