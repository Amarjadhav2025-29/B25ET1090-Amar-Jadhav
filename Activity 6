#include <iostream>
using namespace std;

class Complex {
private:
    double real;
    double imag;

public:

    Complex(double r = 0, double i = 0) {
        real = r;
        imag = i;
    }

// Get Data From User 
    void getData() {
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> imag;
    }

// Function For Display Data 
    void displayData() {
        if (imag >= 0)
            cout << real << " + " << imag << "i" << endl;
        else
            cout << real << " - " << -imag << "i" << endl;
    }


    Complex operator/(Complex c); // Defining Operator Overloading 
};


Complex Complex::operator/(Complex c) {
    Complex temp;
    double denominator = (c.real * c.real) + (c.imag * c.imag);

    if (denominator == 0) {
        cout << "Error: Cannot divide by zero complex number." << endl;
        temp.real = 0;
        temp.imag = 0;
        return temp;
    }

    temp.real = ((real * c.real) + (imag * c.imag)) / denominator;
    temp.imag = ((imag * c.real) - (real * c.imag)) / denominator;
    return temp;
}

//Main Function 
int main() {
    Complex s1, s2, result;
// Function call
    cout << "Input First Complex Number:\n";
    s1.getData();
    
    cout << "tInput Second Complex Number:\n";
    s2.getData();

    cout << "\nFirst Complex Number: ";
    s1.displayData();
    cout << "Second Complex Number: ";
    s2.displayData();

// Display Result 
    result = s1 / s2; 

    cout << "\nResult of Division: ";
    result.displayData();

    return 0;
}
