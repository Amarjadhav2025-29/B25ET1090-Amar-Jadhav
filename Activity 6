#include <iostream>              // Include the standard input-output stream library
using namespace std;            // Use the standard namespace so we don't need to write std::

class Complex {
private:
    double real;
    double imag;

public:

    Complex(double r = 0, double i = 0)    //Parameterized Constructor To Initialize the real and imag
    {
        real = r;
        imag = i;
    }

    // Member Function To Get Real And Imaginary Data From User 
    void getData() {
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    // Function For Display real and imagnary  Data 
    void displayData() {
        if (imag >= 0)
            cout << real << " + " << imag << "i" << endl;
        else
            cout << real << " - " << -imag << "i" << endl;
    }

    // Declaration of member function for division operator overloading (/)
    Complex operator/(Complex c);           
};


// Definition of the overloaded division operator (this / c)
Complex Complex::operator/(Complex c) {
    Complex temp;                                                         // Temperory Object to store the result 
    double denominator = (c.real * c.real) + (c.imag * c.imag);

    if (denominator == 0) {                                              // Check Denominator 
        cout << "Error: Cannot divide by zero complex number." << endl;
        temp.real = 0;
        temp.imag = 0;
        return temp;
    }

    temp.real = ((real * c.real) + (imag * c.imag)) / denominator;
    temp.imag = ((imag * c.real) - (real * c.imag)) / denominator;
    return temp;
}

//Main Function 
int main() {
    Complex s1, s2, result;       // Object Decleration And Calling to constructor 

// Function call for get data 
    cout << "Input First Complex Number:\n";
    s1.getData();
    
    cout << "tInput Second Complex Number:\n";
    s2.getData();

// Function call for Display data 
    cout << "\nFirst Complex Number: ";
    s1.displayData();
    cout << "Second Complex Number: ";
    s2.displayData();


    result = s1 / s2; 

// Display Result 
    cout << "\nResult of Division: ";
    result.displayData();

    return 0;
}
